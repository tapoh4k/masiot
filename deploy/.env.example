# Copy to .env and fill in values before: docker compose up -d --build
#   cp .env.example .env

# --- Postgres ---
POSTGRES_DB=agenti_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

# --- RabbitMQ (do NOT use guest in Docker network) ---
RABBITMQ_USER=masiot
RABBITMQ_PASSWORD=change-me-strong-rmq-password

# --- Encryption (AES-256 key = 32 chars, IV = 16 chars). Keep stable across redeploys. ---
ENCRYPTION_KEY=ChangeMeEncryptionKey32Chars!!
ENCRYPTION_IV=ChangeMeIV16char

# --- App ---
MONITORING_API_KEY=change-me-monitoring-key
# Optional extra CORS origin if UI is served from another host (same-origin /api proxy usually enough)
ALLOWED_ORIGIN=

# Host port for the web UI
FRONTEND_PORT=80

# RabbitMQ Management UI on localhost only
RABBITMQ_MGMT_PORT=15672
